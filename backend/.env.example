GROQ_API_KEY=your_key_from_console.groq.com
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET=change_me
PORT=5000
TELEGRAM_BOT_TOKEN=
# Encrypts stored App Passwords. Set a long random value in production. Changing it makes people reconnect.
SECRET_KEY=
# Email Agent: Gmail connect (Google Cloud > OAuth client, redirect URI below). See the README.
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/Agents
